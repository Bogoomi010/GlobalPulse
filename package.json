{
  "name": "globalpulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages:dev": "wrangler pages dev dist --persist-to .wrangler/state --binding SESSION_TOKEN_SECRET=local-dev-session-secret --binding MODERATION_ADMIN_TOKEN=local-dev-moderation-token --binding APP_PUBLIC_ORIGIN=http://127.0.0.1:8788 --binding ALLOW_DEMO_LOGIN=true --binding TOSS_CLIENT_KEY=test_ck_replace_me --binding TOSS_SECRET_KEY=test_sk_replace_me --port 8788 --install-skills=false",
    "db:migrate:local": "node scripts/apply-local-migrations.mjs",
    "db:migrate:production": "node scripts/apply-production-migrations.mjs",
    "db:migrate:production:dry-run": "node scripts/apply-production-migrations.mjs --dry-run",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:api": "yarn build && node scripts/smoke-api.mjs",
    "check:deploy": "node scripts/check-production-readiness.mjs",
    "deploy": "yarn lint && yarn test:api && yarn check:deploy && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.98.0"
  }
}
