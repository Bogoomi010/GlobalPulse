{
  "name": "globalpulse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages:dev": "wrangler pages dev dist --persist-to .wrangler/state --binding SESSION_TOKEN_SECRET=local-dev-session-secret --binding MODERATION_ADMIN_TOKEN=local-dev-moderation-token --binding APP_PUBLIC_ORIGIN=http://127.0.0.1:8788 --binding ALLOW_DEMO_LOGIN=true --binding AUTH_PROVIDER=resend --binding AUTH_EMAIL_DELIVERY=log --binding AUTH_EMAIL_FROM=local-dev@globalpulse.test --port 8788 --no-install-skills",
    "db:migrate:local": "node scripts/apply-local-migrations.mjs",
    "db:migrate:production": "node scripts/apply-production-migrations.mjs",
    "db:migrate:production:dry-run": "node scripts/apply-production-migrations.mjs --dry-run",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:api": "yarn build && node scripts/smoke-api.mjs",
    "check:deploy": "node scripts/check-production-readiness.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "launch:review": "node scripts/launch-review-report.mjs",
    "goal:status": "node scripts/goal-completion-audit.mjs",
    "goal:complete": "node scripts/goal-completion-audit.mjs --require-complete",
    "audit:cloudflare-secrets": "node scripts/audit-cloudflare-pages-secrets.mjs",
    "cleanup:cloudflare-secrets": "node scripts/cleanup-cloudflare-pages-secrets.mjs",
    "admin:status": "node scripts/admin-runtime.mjs status",
    "admin:ready": "node scripts/admin-runtime.mjs ready",
    "admin:refresh-issues": "node scripts/admin-runtime.mjs refresh-issues",
    "admin:test-email": "node scripts/admin-runtime.mjs test-email",
    "admin:verify-email": "node scripts/admin-runtime.mjs verify-email",
    "deploy": "yarn lint && yarn test:api && yarn check:deploy && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.98.0"
  }
}
